# Diese Datei nach .env kopieren und eigene Werte eintragen.
# Diese Datei NICHT mit echten Keys einchecken - .env ist in .gitignore ausgeschlossen.

# Modellname (Gemini über die OpenAI-kompatible Schnittstelle)
LITELLM_DEFAULT_MODEL=gemini-3.6-flash

# Basis-URL des OpenAI-kompatiblen Endpunkts (hier direkt Gemini)
LITELLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# Gemini-API-Key (AI Studio: https://aistudio.google.com -> "Get API key")
LITELLM_KEY=your-api-key-here
